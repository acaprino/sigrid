{
  "name": "@acaprino/sigrid",
  "version": "5.1.0",
  "private": true,
  "license": "MIT",
  "repository": "github:acaprino/sigrid",
  "description": "A UI system for React apps in four levels, made for coding agents: a toolkit (theme engine, tokens, primitives on Ark UI and Base UI with Park UI's form), advanced components, a layout system, and an app system for Tauri.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "import": "./dist/table.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "import": "./dist/virtual.js"
    },
    "./reorder": {
      "types": "./dist/reorder.d.ts",
      "import": "./dist/reorder.js"
    },
    "./rich-text": {
      "types": "./dist/rich-text.d.ts",
      "import": "./dist/rich-text.js"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "import": "./dist/graph.js"
    },
    "./tauri": {
      "types": "./dist/tauri.d.ts",
      "import": "./dist/tauri.js"
    },
    "./graph.css": "./dist/graph.css",
    "./theme.css": "./src/styles/theme.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./styles.css": "./dist/styles.css",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "tauri",
    "bin",
    "agents",
    "docs",
    "tools/zero-slop-design",
    "AGENTS.md",
    "DESIGN.md",
    "llms.txt",
    "LICENSE",
    "THIRD_PARTY.md",
    "README.md",
    "provenance.json"
  ],
  "bin": {
    "sigrid-check": "./bin/sigrid-check.mjs"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tauri.json --noEmit",
    "showcase": "vite --config showcase/vite.config.mjs",
    "showcase:build": "vite build --config showcase/vite.config.mjs",
    "showcase:typecheck": "tsc -p showcase/tsconfig.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "design:lint": "node tools/zero-slop-design/zsd.mjs lint DESIGN.md --strict",
    "design:check": "node tools/zero-slop-design/zsd.mjs check-code DESIGN.md --config design-check.config.json --strict",
    "agents": "node scripts/agents.mjs",
    "agents:check": "node scripts/agents.mjs --check"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@tauri-apps/api": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@puckeditor/core": "0.24.0",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "2.12.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@ark-ui/react": "5.39.3",
    "@base-ui/react": "1.9.0",
    "@dagrejs/dagre": "3.1.3",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@internationalized/date": "3.12.4",
    "@material/material-color-utilities": "0.4.0",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "@xyflow/react": "13.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "motion": "14.6.0",
    "tailwind-merge": "3.7.0"
  }
}
