{
  "name": "@acaprino/sigrid",
  "version": "2.1.0",
  "private": true,
  "license": "MIT",
  "repository": "github:acaprino/sigrid",
  "description": "A design system for React apps: theme engine and colours, tokens and fonts, primitives on Ark UI and Base UI with Park UI's form, and its own short, opt-in motion.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./src/styles/theme.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./styles.css": "./dist/styles.css",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "THIRD_PARTY.md",
    "README.md",
    "provenance.json"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "showcase": "vite --config showcase/vite.config.mjs",
    "showcase:build": "vite build --config showcase/vite.config.mjs",
    "showcase:typecheck": "tsc -p showcase/tsconfig.json",
    "design:lint": "node tools/zero-slop-design/zsd.mjs lint DESIGN.md --strict",
    "design:check": "node tools/zero-slop-design/zsd.mjs check-code DESIGN.md --config design-check.config.json --strict"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@ark-ui/react": "5.39.3",
    "@base-ui/react": "1.9.0",
    "@fluentui/react-icons": "2.0.345",
    "@internationalized/date": "3.12.4",
    "@material/material-color-utilities": "0.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "motion": "14.6.0",
    "tailwind-merge": "^3.7.0"
  }
}
